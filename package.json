{
  "name": "vividparachute",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "import": "tsx scripts/import-corpus.ts",
    "study": "tsx scripts/study.ts",
    "review:sources": "tsx scripts/review-transcriptions.ts",
    "sync": "tsx scripts/study.ts sync",
    "ship": "tsx scripts/ship.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "katex": "$katex",
    "zod": "$zod"
  },
  "dependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@vercel/blob": "^2.9.0",
    "katex": "^0.19.1",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "puppeteer-core": "^25.18.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
